{
  "name": "shovel",
  "version": "0.0.1",
  "private": true,
  "description": "AIエージェントチャット on Docker Sandboxes",
  "license": "Apache-2.0",
  "author": "tsuty",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "desktopName": "shovel.desktop",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "install-electron && electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "pack:mac": "electron-vite build && electron-builder --mac dir",
    "pack:win": "electron-vite build && electron-builder --win dir --x64",
    "pack:linux": "electron-vite build && electron-builder --linux dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "mermaid": "^12.0.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-license": "^3.7.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
