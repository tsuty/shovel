    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "i18next": "^26.4.2",
    "ignore": "^7.0.9",
    "lucide-react": "^1.12.0",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
